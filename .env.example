# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Anthropic API key. Only required for live runs:
#   npm run eval -- --live
# The default `npm run eval` replays fixtures/llm-cache.json and needs no key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used by both the baseline and the advanced pipeline.
ANTHROPIC_MODEL=claude-sonnet-5
