# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Anthropic API key. Only required for live runs:
#   npm run eval -- --live
# The default `npm run eval` replays fixtures/llm-cache.json and needs no key.
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Optional. Overrides the model both pipelines use; leave it unset to get the pinned
# one in src/llm/key.ts, which is what fixtures/llm-cache.json was recorded with.
# Any other value makes every replay miss — a different model hashes to a different
# cache key — so change it only together with a live re-record.
# ANTHROPIC_MODEL=claude-sonnet-5
